# ========================================================
# Facul Mind — Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha suas credenciais
# ========================================================

PORT=3001

# 1. Google Gemini API (Gratuito em https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui
VITE_GEMINI_API_KEY=sua_chave_gemini_aqui

# 2. Firebase Firestore & Auth (Gratuito em https://console.firebase.google.com/)
VITE_FIREBASE_API_KEY=sua_chave_firebase
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# 3. Puppeteer & SIGAA Scraper
SIGAA_BASE_URL=https://sigaa.ufpe.br
PUPPETEER_HEADLESS=true
